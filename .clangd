CompileFlags:
  CompilationDatabase: build
  Add:
    - -Wall
    - -Wextra
    - -Wpedantic

Diagnostics:
  UnusedIncludes: Strict
  ClangTidy:
    Add:
      - bugprone-*
      - performance-*
      - modernize-*
    Remove:
      - bugprone-easily-swappable-parameters
      - modernize-use-trailing-return-type
      - modernize-avoid-c-arrays

InlayHints:
  Enabled: true
  ParameterNames: true
  DeducedTypes: true
